{
  "manifest_version": 3,
  "name": "Netflix Subtitle Reader Pro",
  "version": "2.0",
  "permissions": ["tts", "storage"],
  "host_permissions": ["https://www.netflix.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}